# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/naarzi

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Client URLs (CORS)
CLIENT_URL=http://localhost:3006
ADMIN_CLIENT_URL=http://localhost:3007

# Cloudinary (Use 'mock_cloud_name' for local mock mode)
CLOUDINARY_CLOUD_NAME=mock_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay (Use 'rzp_test_mockkeyid123' for local mock mode)
RAZORPAY_KEY_ID=rzp_test_mockkeyid123
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
